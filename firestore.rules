rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isBeheerder() {
      return request.auth != null
        && exists(/databases/$(database)/documents/schoolrollen/$(request.auth.uid))
        && get(/databases/$(database)/documents/schoolrollen/$(request.auth.uid)).data.rol == 'beheerder';
    }

    function isSchoolBreed() {
      return request.auth != null
        && exists(/databases/$(database)/documents/schoolrollen/$(request.auth.uid))
        && get(/databases/$(database)/documents/schoolrollen/$(request.auth.uid)).data.rol
           in ['directie', 'zorgcoordinator', 'zorgleerkracht', 'beheerder'];
    }

    function isSecretariaat() {
      return request.auth != null
        && exists(/databases/$(database)/documents/schoolrollen/$(request.auth.uid))
        && get(/databases/$(database)/documents/schoolrollen/$(request.auth.uid)).data.rol
           in ['secretariaat', 'beheerder'];
    }

    function isZorgleerkracht() {
      return request.auth != null
        && exists(/databases/$(database)/documents/schoolrollen/$(request.auth.uid))
        && get(/databases/$(database)/documents/schoolrollen/$(request.auth.uid)).data.rol
           in ['zorgleerkracht', 'beheerder'];
    }

    function isHuiswerkklasBegeleider(schooljaar) {
  return request.auth != null
    && exists(
      /databases/$(database)/documents/huiswerkklas/$(schooljaar)/maanden/configuratie
    )
    && (
      request.auth.uid in get(
        /databases/$(database)/documents/huiswerkklas/$(schooljaar)/maanden/configuratie
      ).data.get('begeleider_uids', [])
      ||
      (
        request.auth.token.email != null
        && request.auth.token.email in get(
          /databases/$(database)/documents/huiswerkklas/$(schooljaar)/maanden/configuratie
        ).data.get('begeleider_emails', [])
      )
    );
}

function isGekoppeldAanKlas(schooljaar, klasId) {
  return request.auth != null
    && exists(
      /databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId)
    )
    && (
      request.auth.uid in get(
        /databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId)
      ).data.leerkracht_uids
      ||
      request.auth.token.email in get(
        /databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId)
      ).data.leerkracht_emails
    );
}

function isGekoppeldAanGroep(groep) {
  return (
    groep.groepId == "graad1"
    && (
      isGekoppeldAanKlas(groep.schooljaar, "1A")
      || isGekoppeldAanKlas(groep.schooljaar, "2A")
    )
  )
  || (
    groep.groepId == "graad2"
    && (
      isGekoppeldAanKlas(groep.schooljaar, "3A")
      || isGekoppeldAanKlas(groep.schooljaar, "4A")
    )
  )
  || (
    groep.groepId == "graad3"
    && (
      isGekoppeldAanKlas(groep.schooljaar, "5A")
      || isGekoppeldAanKlas(groep.schooljaar, "6A")
    )
  );
}

    match /agenda_graad1/{docId} {
      allow read, write: if true;
    }

    match /agenda_graad2/{docId} {
      allow read, write: if true;
    }

    match /agenda_graad3/{docId} {
      allow read, write: if true;
    }

    match /leerkrachten/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isSchoolBreed() || isSecretariaat());

      allow write: if request.auth != null
        && (request.auth.uid == userId || isSchoolBreed());

      match /borden/contractbord {
        allow read, write: if request.auth != null
          && (request.auth.uid == userId || isSchoolBreed());

        allow read: if request.auth != null && request.auth.uid != userId;

        allow update: if request.auth != null
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cellen']);
      }
    }

    match /klasbeheer_teams/{teamId} {
      function isBestellingenDoc() {
        return teamId.matches('bestellingen_.*');
      }

      allow read: if request.auth != null
        && (
          isSchoolBreed()
          || (isSecretariaat() && isBestellingenDoc())
          || request.auth.uid in resource.data.leden_uids
          || request.auth.token.email in resource.data.leden_emails
        );

      allow create: if request.auth != null
        && (
          isSchoolBreed()
          || isSecretariaat()
          || request.resource.data.bestellingenApp == true
          || request.auth.uid in request.resource.data.leden_uids
          || request.auth.token.email in request.resource.data.leden_emails
        );

      allow update: if request.auth != null
        && (
          isSchoolBreed()
          || (isSecretariaat() && isBestellingenDoc())
          || request.auth.uid in resource.data.leden_uids
          || request.auth.token.email in resource.data.leden_emails
        );

      allow delete: if request.auth != null
        && (
          isSchoolBreed()
          || request.auth.uid in resource.data.leden_uids
          || request.auth.token.email in resource.data.leden_emails
        );
    }

    match /schoolrollen/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isSchoolBreed() || isSecretariaat());

      allow write: if false;
    }

    match /klasleerkrachten/{klasId} {
      allow read: if request.auth != null
        && (
          isSchoolBreed()
          || isSecretariaat()
          || request.auth.token.email in resource.data.leerkracht_emails
          || request.auth.uid in resource.data.leerkracht_uids
        );

      allow create, update: if isSecretariaat();

      allow delete: if false;
    }

    match /schoolbeheer/{schooljaar}/klassen/{klasId} {
      allow read, update: if request.auth != null
        && (
          isSecretariaat()
          || isSchoolBreed()
          || (
            exists(/databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId))
            && (
              request.auth.token.email in get(/databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId)).data.leerkracht_emails
              || request.auth.uid in get(/databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId)).data.leerkracht_uids
            )
          )
        );

      allow create, delete: if isSecretariaat();
    }

    match /schoolbeheer/{schooljaar}/secretariaat/{docId} {
      allow read, write: if isSecretariaat();
    }

    match /schoolbeheer/{schooljaar}/instellingen/{docId} {
      allow read: if request.auth != null;
      allow write: if isSecretariaat();
    }

    match /overgangsbesprekingen/{schooljaar}/projecten/{projectId} {
      allow read: if request.auth != null
        && (
          isSchoolBreed()
          || isSecretariaat()
          || projectId == request.auth.uid
          || resource.data.eigenaar_uid == request.auth.uid
          || resource.data.eigenaar_email == request.auth.token.email
        );

      allow create: if request.auth != null
        && (
          isSchoolBreed()
          || isSecretariaat()
          || projectId == request.auth.uid
          || request.resource.data.eigenaar_uid == request.auth.uid
          || request.resource.data.eigenaar_email == request.auth.token.email
        );

      allow update, delete: if request.auth != null
        && (
          isSchoolBreed()
          || isSecretariaat()
          || projectId == request.auth.uid
          || resource.data.eigenaar_uid == request.auth.uid
          || resource.data.eigenaar_email == request.auth.token.email
        );
    }

    match /overgangsbesprekingen/{schooljaar}/dossiers/{dossierId} {
      allow create: if request.auth != null
        && (
          isSchoolBreed()
          || request.resource.data.eigenaar_uid == request.auth.uid
          || request.resource.data.eigenaar_email == request.auth.token.email
        );

      allow read: if request.auth != null
        && (
          isSchoolBreed()
          || resource.data.eigenaar_uid == request.auth.uid
          || resource.data.eigenaar_email == request.auth.token.email
          || resource.data.volgende_leerkracht_email == request.auth.token.email
        );

      allow update: if request.auth != null
        && (
          isSchoolBreed()
          || resource.data.eigenaar_uid == request.auth.uid
          || resource.data.eigenaar_email == request.auth.token.email
          || resource.data.volgende_leerkracht_email == request.auth.token.email
        );

      allow delete: if request.auth != null
        && (
          isSchoolBreed()
          || resource.data.eigenaar_uid == request.auth.uid
        );
    }

    match /zorgoverleggen/{schooljaar}/klassen/{klasId}/maanden/{maandId} {
      allow read, write: if request.auth != null && (
           isSchoolBreed()
          || (
          exists(/databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId))
          && (
          request.auth.token.email in get(/databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId)).data.leerkracht_emails
          || request.auth.uid in get(/databases/$(database)/documents/klasleerkrachten/$(schooljaar + "_" + klasId)).data.leerkracht_uids
              )
           )
        );    
    }

   match /huiswerkklas/{schooljaar}/maanden/configuratie {
  allow read: if request.auth != null;

  allow create, update: if isSecretariaat();

  allow delete: if isBeheerder();
}

match /huiswerkklas/{schooljaar}/maanden/{maandId} {
  allow read: if request.auth != null;

  allow create, update: if maandId != 'configuratie'
    && (
      isSecretariaat()
      || isHuiswerkklasBegeleider(schooljaar)
    );

  allow delete: if maandId != 'configuratie'
    && isBeheerder();
}

     match /klasafspraken/{schooljaar}/klassen/{klasId} {
       allow read, write: if request.auth != null
       && request.auth.token.email == "isabel.rockele@bsdelinde.net";
    }

    match /oudercontacten/{schooljaar}/projecten/{projectId} {
      allow read: if request.auth != null
        && (
          isSchoolBreed()
          || isSecretariaat()
          || projectId == request.auth.uid
          || resource.data.eigenaar_uid == request.auth.uid
          || resource.data.eigenaar_email == request.auth.token.email
        );

      allow create: if request.auth != null
        && (
          isZorgleerkracht()
          || isSecretariaat()
          || projectId == request.auth.uid
          || request.resource.data.eigenaar_uid == request.auth.uid
          || request.resource.data.eigenaar_email == request.auth.token.email
        );

      allow update, delete: if request.auth != null
        && (
          isZorgleerkracht()
          || isSecretariaat()
          || projectId == request.auth.uid
          || resource.data.eigenaar_uid == request.auth.uid
          || resource.data.eigenaar_email == request.auth.token.email
        );
    }

    match /zorggroepen/{groepId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSchoolBreed();
    }
    
    match /veiligheidskopieen/{bronId}/versies/{versieId} {
  allow create: if request.auth != null
    && (
      request.resource.data.gebruiker == request.auth.uid
      || request.resource.data.gebruiker == request.auth.token.email
    );

  allow read: if isSchoolBreed();
  allow update, delete: if isBeheerder();
}

match /schoolbeheer_groepen/{groepDocId} {
  allow read, update: if request.auth != null
    && (
      isSchoolBreed()
      || isSecretariaat()
      || isGekoppeldAanGroep(resource.data)
    );

  allow create: if isSecretariaat();
  allow delete: if isBeheerder();
}

   match /tafelexpeditie_klassen/{toegangscode} {
  allow get: if request.auth != null;
  allow list: if false;

  allow create: if request.auth != null
    && (
      isSchoolBreed()
      || isSecretariaat()
      || isGekoppeldAanKlas(
        request.resource.data.schoolyear,
        request.resource.data.className
      )
    );

  allow update, delete: if request.auth != null
    && (
      isSchoolBreed()
      || isSecretariaat()
      || isGekoppeldAanKlas(
        resource.data.schoolyear,
        resource.data.className
      )
    );

  match /leerlingen/{geheimeLeerlingSleutel} {
    allow get: if request.auth != null;
    allow list: if false;

    allow create: if request.auth != null
      && (
        isSchoolBreed()
        || isSecretariaat()
        || isGekoppeldAanKlas(
          request.resource.data.schoolyear,
          request.resource.data.className
        )
      );

    allow delete: if request.auth != null
      && (
        isSchoolBreed()
        || isSecretariaat()
        || isGekoppeldAanKlas(
          resource.data.schoolyear,
          resource.data.className
        )
      );

    allow update: if request.auth != null
  && (
    request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly([
        'sessions',
        'factStats',
        'completedAssignmentIds'
      ])
    || isSchoolBreed()
    || isSecretariaat()
    || isGekoppeldAanKlas(
      resource.data.schoolyear,
      resource.data.className
    )
  );
  }
}
    
    // ================================================================
    // TAALGROEI — geïsoleerde pilotcollecties
    // Alle paden beginnen met taalgroei_. Bestaande schooltools worden
    // door dit blok niet geraakt.
    // ================================================================

    function isTaalgroeiMedewerkerVoor(data) {
      return request.auth != null
        && (
          isSchoolBreed()
          || (
            data.get('centraleSchooljaar', '') != ''
            && data.get('klas', '') != ''
            && isGekoppeldAanKlas(
              data.get('centraleSchooljaar', ''),
              data.get('klas', '')
            )
          )
        );
    }

    match /taalgroei_config/{docId} {
      // Nodig zodat ook de kindpagina weet dat de veilige pilot actief is.
      allow get: if true;
      allow list: if false;
      allow create, update: if isSchoolBreed();
      allow delete: if isBeheerder();
    }

    match /taalgroei_kinderen/{kindCode} {
      // Een kind kan uitsluitend het document met zijn lange, geheime code
      // openen. De volledige leerlinglijst kan nooit publiek opgevraagd worden.
      allow get: if true;
      allow list: if request.auth != null
        && isTaalgroeiMedewerkerVoor(resource.data);

      allow create: if isTaalgroeiMedewerkerVoor(request.resource.data);
      allow delete: if isTaalgroeiMedewerkerVoor(resource.data);

      allow update: if isTaalgroeiMedewerkerVoor(resource.data)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'voortgang',
          'laatstActief',
          'taak',
          'taakwachtrij',
          'taakgeschiedenis',
          'thema_actief'
        ]);
    }

    match /taalgroei_instellingen/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /taalgroei_klastaken/{taakId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /taalgroei_rapportperiodes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /taalgroei_schooljaren/{docId} {
      allow read, write: if request.auth != null;
    }

    match /taalgroei_rapporten/{docId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}